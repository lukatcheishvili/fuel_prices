# Copy to .env and fill in. .env is git-ignored: it holds this machine's secrets.
AIRFLOW_UID=50000
# Encrypts connections/variables in the database. Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
# Signs the tokens Airflow's own parts use to talk to each other. Any long random string.
JWT_SECRET=
# Login for the web UI at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=
